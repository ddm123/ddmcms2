<script type="text/javascript">
function checkForm(form){
    var elms = form.getElementsByTagName('input'),len = elms.length,result = ['',false];
    var dbDriver = form.db_driver.value;
    document.getElementById('submit-button').disabled = true;
    for(var i = 0; i<len; i++){
        if(dbDriver==='\Ddm\Db\PDO\Sqlite'){
            if(elms[i].name=='db_host' || elms[i].name=='db_port' || elms[i].name=='db_username' || elms[i].name=='db_password'){
                continue;
            }
        }
        if(elms[i].name!='db_password' && elms[i].name!='db_tablepre' && (elms[i].value==='' || /^\s+$/.test(elms[i].value))){
            result[0] = getLabelText(elms[i])+'不能为空';
        }else if(elms[i].value!='' && elms[i].name=='db_tablepre' && !(/^\w+$/.test(elms[i].value))){
            result[0] = '表名前缀必须是英文字母、数字和下划线或者是这些字符的组合';
        }else if(elms[i].name=='other_adminpath' && !(/^\w+$/.test(elms[i].value))){
            result[0] = '后台登录入口会被用于访问后台的URL, 必须是英文字母、数字和下划线或者是这些字符的组合';
        }else if(elms[i].name=='other_cache_prefix' && !(/^\w+$/.test(elms[i].value))){
            result[0] = '缓存键名前缀前缀必须是英文字母、数字和下划线或者是这些字符的组合';
        }
        if(result[0]!=''){
            result[1] = elms[i];
            break;
        }
    }
    if(result[0]=='' && form.admin_password.value!=form.admin_password2.value){
        result[0] = '两次输入的密码不一致';
        result[1] = form.admin_password2;
    }
    if(result[0]!=''){
        document.getElementById('submit-button').disabled = false;
        window.alert(result[0]);
        result[1].focus();
        return false;
    }
    window.setTimeout('document.getElementById("submit-button").innerHTML="还需要些时间, 请耐心等候..."',2000);
    return true;
}
function getLabelText(e){
    var labels = e.parentNode.getElementsByTagName('label'),len = labels.length;
    for(var i = 0; i<len; i++){
        if(labels[i].getAttribute('for')==e.id){
            return labels[i].innerHTML;
        }
    }
    return '';
}
function dbDriverChanged(target){
    var inps = [
        document.getElementById('setting-form').db_host,
        document.getElementById('setting-form').db_port,
        document.getElementById('setting-form').db_username,
        document.getElementById('setting-form').db_password
    ];
    var note = document.getElementById('db_note');
    if(target.value==='\Ddm\Db\PDO\Sqlite'){
        for(var i = 0; i<inps.length; i++)inps[i].parentNode.style.display = 'none';
        if(!note){
            note = document.createElement('div');
            note.setAttribute('id','db_note');
            document.getElementById('setting-form').db_name.parentNode.appendChild(note);
        }
        note.innerHTML = '<label style="padding-top:0;padding-bottom:0;margin:0;line-height:inherit;">&nbsp;</label>请填写数据库文件名'+
        '<br/><label style="padding-top:0;padding-bottom:0;margin:0;line-height:inherit;">&nbsp;</label>千万不要是一个可被URL访问的路径！否则数据库文件将被他人下载！'
        +'<br/><label style="padding-top:0;padding-bottom:0;margin:0;line-height:inherit;">&nbsp;</label>建议是../database/db.sqlite3，或者使用绝对路径放在其它文件夹中。';
    }else{
        if(note)note.parentNode.removeChild(note);
        for(var i = 0; i<inps.length; i++){
            if(inps[i].parentNode.style.display==='none')inps[i].parentNode.style.display = '';
        }
    }
}
document.getElementById('setting-form').db_driver.onchange = function (e) {
    e = e || window.event;
    var target = e.target || e.srcElement;
    dbDriverChanged(target);
};
dbDriverChanged(document.getElementById('setting-form').db_driver)
</script>








